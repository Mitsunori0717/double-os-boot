function Get-AppPurposeAnalysis {
 [CmdletBinding()]param([AllowEmptyString()][string]$DisplayName,[AllowEmptyString()][string]$Publisher)
 $hits=@()
 if($DisplayName.Length -le 200 -and $Publisher.Length -le 200 -and ($DisplayName+$Publisher) -notmatch '[\x00-\x1f\x7f\u061c\u200e\u200f\u202a-\u202e\u2066-\u2069]'){
  $hits=@($script:Catalog|Where-Object{$DisplayName -imatch $_.Pattern -and $Publisher -iin $_.Publishers})
 }
 if($hits.Count -ne 1){
  return [pscustomobject]@{Matched=$false;RuleId='';Category='Unknown';PurposeGroup='不明';PurposeSummary='用途不明。名称・発行元が辞書条件に一致しないため推定しません。';ClassificationBasis='NoUniqueLocalNameAndPublisherMatch';SourceUrls=@();DependencyReviewRequired=$true;Dependencies='Unknown';Necessity='Unknown';Authenticity='NotVerified';NetworkActivity='NotMeasured';CatalogReviewedUtc='2026-11-18'}
 }
 $entry=$hits[0]
 [pscustomobject]@{Matched=$true;RuleId=$entry.Id;Category=$entry.Category;PurposeGroup=$entry.PurposeGroup;PurposeSummary=($entry.Summary+'（登録名・発行元候補による推定。依存関係・不要性は不明）');ClassificationBasis=('LocalCatalog/'+$entry.Id+'; exact publisher candidate and bounded name pattern; NOT signature or legitimacy verification');SourceUrls=@($entry.Url);DependencyReviewRequired=$entry.ReviewRequired;Dependencies='Unknown';Necessity='Unknown';Authenticity='NotVerified';NetworkActivity='NotMeasured';CatalogReviewedUtc='2026-11-18'}
}
Export-ModuleMember -Function Get-AppPurposeAnalysis
